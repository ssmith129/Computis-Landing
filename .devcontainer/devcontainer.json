              <body class="h-full text-base-content">
                <nav id="header" class="bg-white sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <span class="flex-shrink-0 flex items-center cursor-pointer">
          <div class="text-2xl font-bold bg-gradient-to-r from-blue-500 to-green-400 bg-clip-text text-transparent">
            Computis
          </div>
        </span>
        <div class="hidden md:ml-10 md:flex md:space-x-8">
          <span class="text-gray-700 hover:text-blue-500 px-3 py-2 text-sm font-medium cursor-pointer">Product</span>
          <span class="text-gray-700 hover:text-blue-500 px-3 py-2 text-sm font-medium cursor-pointer">Features</span>
          <span class="text-gray-700 hover:text-blue-500 px-3 py-2 text-sm font-medium cursor-pointer">Use Cases</span>
          <span class="text-gray-700 hover:text-blue-500 px-3 py-2 text-sm font-medium cursor-pointer">Pricing</span>
          <span class="text-gray-700 hover:text-blue-500 px-3 py-2 text-sm font-medium cursor-pointer">Blog</span>
        </div>
      </div>
      <div class="hidden md:flex items-center">
        <span class="text-gray-700 hover:text-blue-500 px-3 py-2 text-sm font-medium cursor-pointer">Log in</span>
        <span class="ml-4 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-gradient-to-r from-blue-500 to-green-400 hover:from-blue-600 hover:to-green-500 cursor-pointer">
          Request a Demo
        </span>
      </div>
      <div class="flex items-center md:hidden">
        <button type="button" class="inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-blue-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Hero Section -->
<section id="hero" class="relative bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto pt-16 pb-24 px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-8">
      <div class="sm:text-center md:max-w-2xl md:mx-auto lg:col-span-6 lg:text-left">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
          <span class="block">Accurate Crypto Tax</span>
          <span class="block bg-gradient-to-r from-blue-500 to-green-400 bg-clip-text text-transparent">Calculations. Automated. Compliant.</span>
        </h1>
        <p class="mt-6 text-base text-gray-500 sm:text-lg md:text-xl">
          Seamless integration with exchanges, wallets, and blockchains for complete tax reporting that meets regulatory requirements.
        </p>
        <div class="mt-8 sm:flex sm:justify-center lg:justify-start">
          <div class="rounded-md shadow">
            <span class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-gradient-to-r from-blue-500 to-green-400 hover:from-blue-600 hover:to-green-500 md:py-4 md:text-lg md:px-10 cursor-pointer">
              Request a Demo
            </span>
          </div>
          <div class="mt-3 sm:mt-0 sm:ml-3">
            <span class="w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-blue-500 bg-white hover:bg-gray-50 border-blue-500 md:py-4 md:text-lg md:px-10 cursor-pointer">
              Connect Wallet
            </span>
          </div>
        </div>
      </div>
      <div class="mt-12 relative sm:max-w-lg sm:mx-auto lg:mt-0 lg:max-w-none lg:mx-0 lg:col-span-6 lg:flex lg:items-center">
        <div class="relative mx-auto w-full rounded-lg shadow-lg lg:max-w-md">
          <div class="relative block w-full bg-white rounded-lg overflow-hidden">
            <img class="w-full" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/ae7b70e84a-1924aac7284824635aaa.png" alt="crypto tax dashboard interface with floating metrics, blue and green gradient accents, modern UI design, fintech style" />
            <div class="absolute inset-0 bg-gradient-to-tr from-blue-500/20 to-green-400/20 mix-blend-multiply"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Floating UI Elements for Visual Appeal -->
  <div class="absolute top-1/4 right-10 w-16 h-16 bg-gradient-to-r from-blue-400 to-green-300 rounded-full opacity-20 animate-pulse"></div>
  <div class="absolute bottom-1/3 left-10 w-24 h-24 bg-gradient-to-r from-green-300 to-blue-400 rounded-full opacity-10 animate-pulse delay-1000"></div>
</section>

<!-- Partners Banner -->
<section id="partners" class="bg-gray-50 py-6">
