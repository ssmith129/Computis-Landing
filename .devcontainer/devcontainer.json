<!-- Scroll To Top Button - Shows when scrolled down -->
<div class="fixed bottom-6 left-6 z-50 hidden" id="scroll-top-button">
  <button class="bg-white text-blue-500 rounded-full p-3 shadow-lg border border-gray-200 hover:bg-gray-50">
    <i class="fa-solid fa-arrow-up text-lg"></i>
  </button>
</div>

<script>
  // Show/hide scroll to top button
  window.addEventListener('scroll', function() {
    const scrollButton = document.getElementById('scroll-top-button');
    if (window.scrollY > 500) {
      scrollButton.classList.remove('hidden');
    } else {
      scrollButton.classList.add('hidden');
    }
  });
  
  // Scroll to top when button is clicked
  document.getElementById('scroll-top-button')?.addEventListener('click', function() {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>
